{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/uaskills/skill-manifest.schema.json",
  "title": "Universal skill manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "source_url",
    "repository",
    "local_path",
    "original_format",
    "normalized_format",
    "category",
    "license",
    "content_checksum",
    "tree_checksum",
    "import_timestamp",
    "update_timestamp",
    "verification_status",
    "security_scan_status",
    "compatibility_status",
    "quality_assessment",
    "deprecation_status",
    "lifecycle_status",
    "resource_kind",
    "is_synthetic",
    "extensions"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 8 },
    "name": { "type": ["string", "null"] },
    "name_source": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "description_source": { "type": ["string", "null"] },
    "source_url": { "type": ["string", "null"] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "owner", "name", "url"],
      "properties": {
        "host": { "type": ["string", "null"] },
        "owner": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] }
      }
    },
    "commit_sha": { "type": ["string", "null"] },
    "version": { "type": ["string", "null"] },
    "local_path": { "type": ["string", "null"] },
    "origin_path": { "type": ["string", "null"] },
    "skill_relpath": { "type": ["string", "null"] },
    "original_format": { "type": "string" },
    "normalized_format": { "type": "string", "const": "uaskills.manifest.v1" },
    "category": { "type": ["string", "null"] },
    "tags": { "type": ["array", "null"], "items": { "type": "string" } },
    "capabilities": { "type": ["array", "null"], "items": { "type": "string" } },
    "supported_runtimes": { "type": ["array", "null"], "items": { "type": "string" } },
    "required_tools": { "type": ["array", "null"], "items": { "type": "string" } },
    "dependencies": { "type": ["array", "null"], "items": { "type": "string" } },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "evidence", "status"],
      "properties": {
        "identifier": { "type": ["string", "null"] },
        "evidence": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["unknown", "declared", "reviewed"] }
      }
    },
    "content_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "tree_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "import_timestamp": { "type": "string" },
    "update_timestamp": { "type": "string" },
    "verification_status": { "type": "string", "enum": ["unverified", "tested", "verified"] },
    "security_scan_status": { "type": "string", "enum": ["not_scanned", "screened"] },
    "security_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "message"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "high"] },
          "message": { "type": "string" },
          "path": { "type": ["string", "null"] }
        }
      }
    },
    "compatibility_status": { "type": "string", "enum": ["unknown", "declared"] },
    "compatibility": { "type": ["string", "null"] },
    "quality_assessment": {
      "type": "string",
      "enum": [
        "unassessed",
        "missing_instructions",
        "missing_description",
        "missing_declared_name",
        "structurally_complete"
      ]
    },
    "deprecation_status": { "type": "string", "enum": ["unknown", "active", "deprecated"] },
    "lifecycle_status": {
      "type": "string",
      "enum": ["discovered", "imported", "parsed", "quarantined", "deprecated"]
    },
    "resource_kind": { "type": "string" },
    "duplicate_of": { "type": ["string", "null"] },
    "is_synthetic": { "type": "boolean" },
    "extensions": { "type": "object" }
  }
}
